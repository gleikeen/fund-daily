#!/bin/bash
# Git pre-commit hook: 校验基金报告是否含多Agent分析证据
# 安装方法: git config core.hooksPath .githooks
# 或: ln -sf ../../.githooks/pre-commit .git/hooks/pre-commit

REPORT=$(git diff --cached --name-only | grep -E '^fund-report-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}\.html$' | head -1)

if [ -z "$REPORT" ]; then
    # 没有基金报告在暂存区，跳过校验
    exit 0
fi

# 检查文件是否存在
if [ ! -f "$REPORT" ]; then
    exit 0
fi

# 检查报告中是否包含 Multi-Agent 标识和至少6个基金评分卡
AGENT_COUNT=$(grep -c 'Multi-Agent' "$REPORT" 2>/dev/null || echo 0)
FUND_CARDS=$(grep -c 'class="card"' "$REPORT" 2>/dev/null || echo 0)

if [ "$AGENT_COUNT" -lt 2 ] || [ "$FUND_CARDS" -lt 6 ]; then
    echo ""
    echo "❌ 校验失败：基金报告缺少多Agent分析证据！"
    echo "   基金报告HTML必须包含以下特征："
    echo "   - 标题或内容包含 'Multi-Agent' 标识（当前: $AGENT_COUNT 处）"
    echo "   - 至少6个基金评分卡（class=card）（当前: $FUND_CARDS 个）"
    echo ""
    echo "   这通常意味着没有实际 spawn 8 个独立 Agent 进行并行分析。"
    echo "   请重新执行 fund-report-multiagent 技能工作流，确保 Step 4 已执行。"
    echo ""
    echo "   如需强制提交（不推荐）：git commit --no-verify"
    exit 1
fi

echo "✅ 校验通过：基金报告已包含多Agent分析证据"
exit 0
